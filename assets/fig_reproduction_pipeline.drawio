        <!-- ────────────────────────────────────────────────────────────── -->
        <mxCell id="card_p5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="750" height="72" as="geometry" />
        </mxCell>
        <mxCell id="badge_p5" value="&lt;b style=&quot;font-size:8.5px;color:#ffffff;&quot;&gt;PHASE 5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2185b;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="62" y="530" width="60" height="18" as="geometry" />
        </mxCell>
        <mxCell id="txt_p5_title" value="&lt;b style=&quot;font-size:9.5px;color:#880e4f;&quot;&gt;Publication Table &amp;amp; High-DPI Figure Generation Suite&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="130" y="529" width="450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="txt_p5_body" value="&lt;div align=&quot;left&quot; style=&quot;font-size:7.5px;color:#37474f;line-height:1.3;&quot;&gt;&amp;bull; &lt;b&gt;CLI Commands:&lt;/b&gt; &lt;code style=&quot;color:#880e4f;background:#ffffff;padding:1px 3px;&quot;&gt;./.venv/bin/python -m scripts.generate_paper_tables_v7&lt;/code&gt; &amp;amp; &lt;code style=&quot;color:#880e4f;background:#ffffff;padding:1px 3px;&quot;&gt;generate_paper_figures_v7&lt;/code&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Outputs in output/paper_data/:&lt;/b&gt; Table 1 (Calibration), Table 2 (1,300 Runs), Table 3 (Delay Ladder), Table 4 (Pareto Ablation).&lt;br/&gt;&amp;bull; &lt;b&gt;Outputs in figures/:&lt;/b&gt; Publication-grade 300+ DPI figures (Fig 2 Trajectories, Fig 3 Delay Ladder, Fig 4 Boxplots, Fig 5 Pareto).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="130" y="548" width="655" height="40" as="geometry" />
        </mxCell>

        <!-- Final Certification Footer -->
        <mxCell id="footer_cert" value="&lt;b style=&quot;font-size:8px;color:#2e7d32;&quot;&gt;&amp;#10003; All pipelines execute strictly via root module invocation (&lt;code&gt;./.venv/bin/python -m &amp;lt;module&amp;gt;&lt;/code&gt;) with zero hardcoding.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">

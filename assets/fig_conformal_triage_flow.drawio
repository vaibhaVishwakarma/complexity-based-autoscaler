<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Conformal-Triage-Flow">
    <mxGraphModel dx="900" dy="450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer Frame -->
        <mxCell id="outer_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cfd8dc;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="15" y="15" width="870" height="400" as="geometry" />
        </mxCell>

        <!-- Diagram Header Title -->
        <mxCell id="title_box" value="&lt;b style=&quot;font-size:12px;color:#1a237e;letter-spacing:0.5px;&quot;&gt;CONFORMAL SPLIT-INFERENCE TRIAGE &amp;amp; FEED-FORWARD TELEMETRY FLOW&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="25" y="22" width="850" height="20" as="geometry" />
        </mxCell>

        <!-- Step 1: Ingress Client -->
        <mxCell id="node_ingress" value="&lt;b style=&quot;font-size:10px;color:#0d47a1;&quot;&gt;Ingress Stream &amp;lambda;(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.5px;color:#455a64;&quot;&gt;Tiny ImageNet-C Payloads&lt;br/&gt;Azure 2019 / Poisson Dynamics&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="68" width="145" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow: Ingress -> Edge Gateway -->
        <mxCell id="arr_ing_edge" value="" style="endArrow=classic;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="95" as="sourcePoint" />
            <mxPoint x="225" y="95" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_loc_link" value="&lt;span style=&quot;font-size:7px;color:#0288d1;font-weight:bold;&quot;&gt;Local Link&lt;br/&gt;5ms, 1Gbps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=bottom;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="175" y="68" width="55" height="24" as="geometry" />
        </mxCell>

        <!-- Step 2: Edge Gateway Container -->
        <mxCell id="box_edge" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="225" y="55" width="230" height="185" as="geometry" />
        </mxCell>
        <mxCell id="lbl_edge_hdr" value="&lt;b style=&quot;font-size:9.5px;color:#1b5e20;&quot;&gt;Distributed Edge Gateway (RAPS Triage)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="230" y="58" width="220" height="18" as="geometry" />
        </mxCell>

        <!-- Triage Engine Card -->
        <mxCell id="card_triage" value="&lt;b style=&quot;font-size:7.5px;color:#1b5e20;&quot;&gt;EfficientNet-B0 ONNX Classifier&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;center&quot; style=&quot;font-size:6.5px;color:#37474f;line-height:1.2;&quot;&gt;Inference: 3.0ms &amp;bull; Headroom &amp;gt; 300 RPS&lt;br/&gt;Computes Conformal Set &lt;b&gt;C(x)&lt;/b&gt;&lt;br/&gt;RAPS &lt;b&gt;q&#770; = 0.79914&lt;/b&gt; (&amp;alpha; = 0.10)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#81c784;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="238" y="76" width="204" height="42" as="geometry" />
        </mxCell>

        <!-- Conformal Decision Diamond -->
        <mxCell id="node_decision" value="&lt;b style=&quot;font-size:8px;color:#e65100;&quot;&gt;Cardinality&lt;br/&gt;|C(x)|&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="298" y="142" width="84" height="44" as="geometry" />
        </mxCell>

        <!-- Arrow: Classifier -> Decision -->
        <mxCell id="arr_card_dec" value="" style="endArrow=classic;html=1;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="118" as="sourcePoint" />
            <mxPoint x="340" y="142" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Telemetry Hook Bar inside Edge -->
        <mxCell id="edge_telemetry" value="&lt;b style=&quot;font-size:7px;color:#1b5e20;&quot;&gt;Edge Telemetry Hook:&lt;/b&gt; &lt;span style=&quot;font-size:7px;color:#2e7d32;&quot;&gt;Measures local triage ratio &lt;b&gt;p&lt;sub&gt;fast&lt;/sub&gt;(t)&lt;/b&gt; and velocity &lt;b&gt;&amp;Delta;p(t)&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="235" y="206" width="210" height="22" as="geometry" />
        </mxCell>

        <!-- Fast Path: Arrow to Local Edge Sink -->
        <mxCell id="arr_fast" value="" style="endArrow=classic;html=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="298" y="164" as="sourcePoint" />
            <mxPoint x="180" y="164" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_fast_cond" value="&lt;b style=&quot;font-size:7.5px;color:#2e7d32;&quot;&gt;|C(x)| = 1 (Singleton)&lt;br/&gt;Fast Path&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="190" y="136" width="100" height="26" as="geometry" />
        </mxCell>

        <!-- Fast Path Destination: Edge Sink -->
        <mxCell id="node_edgesink" value="&lt;b style=&quot;font-size:9.5px;color:#1b5e20;&quot;&gt;Local Edge Sink&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.5px;color:#33691e;&quot;&gt;&amp;bull; Zero Cloud Queue Dwell&lt;br/&gt;&amp;bull; Zero Cloud GPU Cost&lt;br/&gt;&amp;bull; Sub-Second Latency (~5ms)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="138" width="145" height="52" as="geometry" />
        </mxCell>

        <!-- Slow Path: Arrow to Cloud WAN -->
        <mxCell id="arr_slow" value="" style="endArrow=classic;html=1;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="382" y="164" as="sourcePoint" />
            <mxPoint x="500" y="164" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_slow_cond" value="&lt;b style=&quot;font-size:7.5px;color:#c62828;&quot;&gt;|C(x)| &amp;ge; 2 (Ambiguous)&lt;br/&gt;Slow Path Offload&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=bottom;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="390" y="136" width="105" height="26" as="geometry" />
        </mxCell>

        <!-- WAN Link Badge -->
        <mxCell id="node_wan" value="&lt;span style=&quot;font-size:7px;color:#d84315;font-weight:bold;&quot;&gt;Stochastic WAN Link&lt;br/&gt;15&amp;ndash;35ms RTT, 1 Gbps&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="149" width="95" height="30" as="geometry" />
        </mxCell>

        <!-- Arrow: WAN -> Cloud Queue -->
        <mxCell id="arr_wan_cloud" value="" style="endArrow=classic;html=1;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="595" y="164" as="sourcePoint" />
            <mxPoint x="635" y="164" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Cloud GPU Fleet Container -->
        <mxCell id="box_cloud" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f57f17;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="635" y="55" width="235" height="185" as="geometry" />
        </mxCell>
        <mxCell id="lbl_cloud_hdr" value="&lt;b style=&quot;font-size:9.5px;color:#e65100;&quot;&gt;Elastic Cloud GPU Fleet (NVIDIA Tesla T4)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="58" width="225" height="18" as="geometry" />
        </mxCell>

        <!-- Cloud FIFO Queue Card -->
        <mxCell id="card_queue" value="&lt;b style=&quot;font-size:7.5px;color:#b71c1c;&quot;&gt;Cloud FIFO Queue q(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:6.8px;color:#37474f;&quot;&gt;Dynamic batching: b &amp;le; 32 (40ms)&lt;br/&gt;Firm SLA Target: &lt;b&gt;D&lt;sub&gt;SLA&lt;/sub&gt; = 15.0s&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef9a9a;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="647" y="76" width="210" height="34" as="geometry" />
        </mxCell>

        <!-- Cloud Worker Pool Card -->
        <mxCell id="card_workers" value="&lt;b style=&quot;font-size:7.5px;color:#e65100;&quot;&gt;Triton GPU Worker Pool k(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:6.8px;color:#37474f;&quot;&gt;ResNet-152 &amp;bull; &lt;b&gt;&amp;mu; = 16.0 RPS/worker&lt;/b&gt;&lt;br/&gt;Elastic Pool: k(t) &amp;isin; [1, 18] workers&lt;br/&gt;Startup Delay: &lt;b&gt;T&lt;sub&gt;boot&lt;/sub&gt; &amp;isin; [1, 300]s&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffe082;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="647" y="134" width="210" height="46" as="geometry" />
        </mxCell>

        <!-- Arrow: Queue -> Workers -->
        <mxCell id="arr_q_work" value="" style="endArrow=classic;html=1;strokeColor=#f57f17;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="752" y="110" as="sourcePoint" />
            <mxPoint x="752" y="134" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Cloud Telemetry Hook Bar inside Cloud -->
        <mxCell id="cloud_telemetry" value="&lt;b style=&quot;font-size:7px;color:#e65100;&quot;&gt;Cloud Telemetry Hook:&lt;/b&gt; &lt;span style=&quot;font-size:7px;color:#bf360c;&quot;&gt;Monitors queue backlog &lt;b&gt;q(t)&lt;/b&gt; and active workers &lt;b&gt;k(t)&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#ffa000;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="647" y="204" width="210" height="24" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- CGDA AUTOSCALING CONTROLLER (LOWER LAYER)                      -->
        <!-- ============================================================== -->
        <mxCell id="box_cgda" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="140" y="275" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lbl_cgda_hdr" value="&lt;b style=&quot;font-size:10px;color:#311b92;&quot;&gt;CGDA: Conformal-Gated Dual-Horizon Autoscaler (Control Epoch &amp;Delta;t = 5.0s)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="279" width="600" height="18" as="geometry" />
        </mxCell>

        <!-- Fast Inner Loop Card -->
        <mxCell id="card_fast_loop" value="&lt;b style=&quot;font-size:8px;color:#1b5e20;&quot;&gt;Fast Inner Loop: Complexity-Derivative Preemption&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:7px;color:#37474f;line-height:1.2;padding-left:4px;&quot;&gt;&amp;bull; Drift velocity: &lt;b&gt;&amp;Delta;p(t) = p&lt;sub&gt;fast&lt;/sub&gt;(t) &amp;minus; p&lt;sub&gt;fast&lt;/sub&gt;(t&amp;minus;1)&lt;/b&gt;&lt;br/&gt;&amp;bull; Triggers preemption when &lt;b&gt;&amp;Delta;p(t) &amp;lt; &amp;minus;&amp;theta;&lt;sub&gt;shock&lt;/sub&gt;&lt;/b&gt;&lt;br/&gt;&amp;bull; Preemptive quota: &lt;b&gt;&amp;delta;&lt;sub&gt;pre&lt;/sub&gt; = &amp;lceil;&amp;lambda;(1&amp;minus;p&lt;sub&gt;fast&lt;/sub&gt;)/&amp;mu;&amp;rceil; &amp;minus; k(t)&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Anti-thrashing lock&lt;/b&gt;: Enforces &lt;b&gt;C&lt;sub&gt;boot&lt;/sub&gt;(t) &amp;gt; 0&lt;/b&gt; during startup&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5d6a7;strokeWidth=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="155" y="301" width="285" height="84" as="geometry" />
        </mxCell>

        <!-- Slow Outer Loop Card -->
        <mxCell id="card_slow_loop" value="&lt;b style=&quot;font-size:8px;color:#311b92;&quot;&gt;Slow Outer Loop: Capacity Stability &amp;amp; Hysteresis&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:7px;color:#37474f;line-height:1.2;padding-left:4px;&quot;&gt;&amp;bull; Capacity target: &lt;b&gt;k*(t) = &amp;lceil;(&amp;lambda;&lt;sub&gt;slow&lt;/sub&gt; + &amp;beta;&amp;middot;q(t))/&amp;mu;&amp;rceil;&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Asymmetric Hysteresis&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; Aggressive scale-up: when &lt;b&gt;k* &amp;gt; k&lt;/b&gt; and &lt;b&gt;C&lt;sub&gt;boot&lt;/sub&gt; = 0&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; Conservative scale-down: delayed by &lt;b&gt;&amp;Delta;t&lt;sub&gt;down&lt;/sub&gt; &amp;ge; 15s&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;strokeWidth=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="455" y="301" width="290" height="84" as="geometry" />
        </mxCell>

        <!-- Feed-forward Telemetry Arrow: Edge -> CGDA -->
        <mxCell id="arr_tel_edge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;strokeWidth=1.8;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="228" as="sourcePoint" />
            <mxPoint x="320" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tel_edge" value="&lt;span style=&quot;font-size:7.2px;color:#1b5e20;font-weight:bold;background:#ffffff;&quot;&gt;Zero-Lag Complexity Telemetry: &amp;lang;&amp;lambda;, p&lt;sub&gt;fast&lt;/sub&gt;, &amp;Delta;p&amp;rang;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="246" width="200" height="14" as="geometry" />
        </mxCell>

        <!-- Telemetry Arrow: Cloud -> CGDA -->
        <mxCell id="arr_tel_cloud" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#e65100;strokeWidth=1.8;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="228" as="sourcePoint" />
            <mxPoint x="670" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tel_cloud" value="&lt;span style=&quot;font-size:7.2px;color:#bf360c;font-weight:bold;background:#ffffff;&quot;&gt;Queue State: &amp;lang;q(t), k(t)&amp;rang;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="615" y="246" width="110" height="14" as="geometry" />
        </mxCell>

        <!-- Scaling Command Arrow: CGDA -> Cloud Workers -->
        <mxCell id="arr_scale_cmd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b71c1c;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="340" as="sourcePoint" />
            <mxPoint x="840" y="236" as="targetPoint" />
            <Array as="points">
              <mxPoint x="840" y="340" />
              <mxPoint x="840" y="236" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_scale_cmd" value="&lt;span style=&quot;font-size:7.5px;color:#b71c1c;font-weight:bold;background:#ffffff;&quot;&gt;Preemptive Actuation Directive &amp;Delta;k(t)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="725" y="285" width="150" height="14" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

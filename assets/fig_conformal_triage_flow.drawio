            <mxPoint x="374" y="138" as="sourcePoint" />
            <mxPoint x="374" y="152" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Edge Telemetry Hook Bar inside Edge (Generous Height and Width) -->
        <mxCell id="edge_telemetry" value="&lt;b style=&quot;font-size:7.5px;color:#1b5e20;&quot;&gt;Edge Telemetry Hook&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.2px;color:#2e7d32;&quot;&gt;Measures local triage ratio &lt;b&gt;p&lt;sub&gt;fast&lt;/sub&gt;(t)&lt;/b&gt; &amp;amp; velocity &lt;b&gt;&amp;Delta;p(t)&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="222" width="248" height="38" as="geometry" />
        </mxCell>

        <!-- Fast Path: Arrow to Local Edge Sink -->

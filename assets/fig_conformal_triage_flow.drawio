            <mxPoint x="178" y="175" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_fast_cond" value="&lt;b style=&quot;font-size:7.5px;color:#2e7d32;background-color:#ffffff;padding:2px 4px;border:1px solid #c8e6c9;&quot;&gt;|C(x)| = 1 (Singleton)&lt;br/&gt;Local Fast Path&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="195" y="146" width="115" height="26" as="geometry" />
        </mxCell>

        <!-- Fast Path Destination: Edge Sink -->
        <mxCell id="node_edgesink" value="&lt;b style=&quot;font-size:10px;color:#1b5e20;&quot;&gt;Local Edge Sink&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.5px;color:#33691e;line-height:1.35;&quot;&gt;&amp;bull; Zero Cloud Queue Dwell&lt;br/&gt;&amp;bull; Zero Cloud GPU Compute Cost&lt;br/&gt;&amp;bull; Sub-Second Latency (~10.7ms)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="26" y="152" width="152" height="66" as="geometry" />
        </mxCell>

        <!-- Slow Path: Arrow to Cloud WAN -->
        <mxCell id="arr_slow" value="" style="endArrow=classic;html=1;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="419" y="175" as="sourcePoint" />
            <mxPoint x="526" y="175" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_slow_cond" value="&lt;b style=&quot;font-size:7.5px;color:#c62828;background-color:#ffffff;padding:2px 4px;border:1px solid #ffcdd2;&quot;&gt;|C(x)| &amp;ge; 2 (Ambiguous)&lt;br/&gt;Slow Path Offload&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="415" y="146" width="112" height="26" as="geometry" />
        </mxCell>

        <!-- WAN Link Badge -->
        <mxCell id="node_wan" value="&lt;b style=&quot;font-size:8px;color:#d84315;&quot;&gt;Stochastic WAN Link&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.2px;color:#bf360c;&quot;&gt;15&amp;ndash;35ms RTT &amp;bull; 1 Gbps&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="526" y="156" width="116" height="38" as="geometry" />
        </mxCell>

        <!-- Arrow: WAN -> Cloud Queue -->
        <mxCell id="arr_wan_cloud" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c62828;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="642" y="175" as="sourcePoint" />
            <mxPoint x="674" y="112" as="targetPoint" />
            <Array as="points">
              <mxPoint x="656" y="175" />
              <mxPoint x="656" y="112" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Cloud GPU Fleet Container -->
        <mxCell id="box_cloud" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f57f17;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="674" y="60" width="272" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lbl_cloud_hdr" value="&lt;b style=&quot;font-size:10px;color:#e65100;&quot;&gt;Elastic Cloud GPU Fleet (NVIDIA Tesla T4)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="678" y="64" width="264" height="20" as="geometry" />
        </mxCell>

        <!-- Cloud FIFO Queue Card -->
        <mxCell id="card_queue" value="&lt;b style=&quot;font-size:8px;color:#b71c1c;&quot;&gt;Cloud FIFO Queue q(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7px;color:#37474f;line-height:1.35;&quot;&gt;Dynamic batching: b &amp;le; 32 (timeout 40ms)&lt;br/&gt;Firm Latency Target: &lt;b&gt;D&lt;sub&gt;SLA&lt;/sub&gt; = 15.0s&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef9a9a;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="686" y="88" width="248" height="42" as="geometry" />
        </mxCell>

        <!-- Arrow: Queue -> Workers -->
        <mxCell id="arr_q_work" value="" style="endArrow=classic;html=1;strokeColor=#f57f17;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="130" as="sourcePoint" />
            <mxPoint x="810" y="146" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Cloud Worker Pool Card -->
        <mxCell id="card_workers" value="&lt;b style=&quot;font-size:8px;color:#e65100;&quot;&gt;Triton GPU Worker Pool k(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7px;color:#37474f;line-height:1.35;&quot;&gt;ResNet-152 &amp;bull; Service Capacity &lt;b&gt;&amp;mu; = 16.0 RPS/worker&lt;/b&gt;&lt;br/&gt;Elastic Pool: k(t) &amp;isin; [1, 18] GPU workers&lt;br/&gt;Container Startup Delay: &lt;b&gt;T&lt;sub&gt;boot&lt;/sub&gt; &amp;le; 15.0s&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffe082;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="686" y="146" width="248" height="58" as="geometry" />
        </mxCell>

        <!-- Cloud Telemetry Hook Bar inside Cloud (Generous Height and Width) -->
        <mxCell id="cloud_telemetry" value="&lt;b style=&quot;font-size:7.5px;color:#e65100;&quot;&gt;Cloud Telemetry Hook&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:7.2px;color:#bf360c;&quot;&gt;Monitors queue backlog &lt;b&gt;q(t)&lt;/b&gt; &amp;amp; active workers &lt;b&gt;k(t)&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe082;strokeColor=#ffa000;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="686" y="222" width="248" height="38" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- CGDA AUTOSCALING CONTROLLER (LOWER LAYER)                      -->
        <!-- ============================================================== -->
        <mxCell id="box_cgda" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="120" y="328" width="736" height="142" as="geometry" />
        </mxCell>
        <mxCell id="lbl_cgda_hdr" value="&lt;b style=&quot;font-size:11px;color:#311b92;&quot;&gt;CGDA: Conformal-Gated Dual-Horizon Autoscaler (Control Epoch &amp;Delta;t = 5.0s)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="130" y="332" width="716" height="20" as="geometry" />
        </mxCell>

        <!-- Fast Inner Loop Card -->
        <mxCell id="card_fast_loop" value="&lt;b style=&quot;font-size:8.5px;color:#1b5e20;&quot;&gt;Fast Inner Loop: Complexity-Derivative Preemption&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:7.3px;color:#37474f;line-height:1.35;padding-left:6px;padding-top:2px;&quot;&gt;&amp;bull; Drift velocity: &lt;b&gt;&amp;Delta;p(t) = p&lt;sub&gt;fast&lt;/sub&gt;(t) &amp;minus; p&lt;sub&gt;fast&lt;/sub&gt;(t&amp;minus;1)&lt;/b&gt;&lt;br/&gt;&amp;bull; Triggers preemption when &lt;b&gt;&amp;Delta;p(t) &amp;lt; &amp;minus;&amp;theta;&lt;sub&gt;shock&lt;/sub&gt;&lt;/b&gt; (&amp;theta;&lt;sub&gt;shock&lt;/sub&gt; = 0.08)&lt;br/&gt;&amp;bull; Preemptive quota: &lt;b&gt;&amp;delta;&lt;sub&gt;pre&lt;/sub&gt; = &amp;lceil;&amp;lambda;(1&amp;minus;p&lt;sub&gt;fast&lt;/sub&gt;)/&amp;mu;&amp;rceil; &amp;minus; k(t)&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Anti-thrashing lock&lt;/b&gt;: Enforces &lt;b&gt;C&lt;sub&gt;boot&lt;/sub&gt;(t) &amp;gt; 0&lt;/b&gt; during startup&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5d6a7;strokeWidth=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="135" y="356" width="346" height="102" as="geometry" />
        </mxCell>

        <!-- Slow Outer Loop Card -->
        <mxCell id="card_slow_loop" value="&lt;b style=&quot;font-size:8.5px;color:#311b92;&quot;&gt;Slow Outer Loop: Capacity Stability &amp;amp; Hysteresis&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:7.3px;color:#37474f;line-height:1.35;padding-left:6px;padding-top:2px;&quot;&gt;&amp;bull; Baseline target: &lt;b&gt;k*(t) = &amp;lceil;(&amp;lambda;&lt;sub&gt;slow&lt;/sub&gt; + &amp;beta;&amp;middot;q(t))/&amp;mu;&amp;rceil;&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Asymmetric Hysteresis Policy&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; Aggressive scale-up: when &lt;b&gt;k* &amp;gt; k&lt;/b&gt; and &lt;b&gt;C&lt;sub&gt;boot&lt;/sub&gt; = 0&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;ndash; Conservative scale-down: delayed by &lt;b&gt;&amp;tau;&lt;sub&gt;down&lt;/sub&gt; &amp;ge; 15s&lt;/b&gt; (3 epochs)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b39ddb;strokeWidth=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="495" y="356" width="350" height="102" as="geometry" />
        </mxCell>

        <!-- Feed-forward Telemetry Arrow: Edge -> CGDA -->
        <mxCell id="arr_tel_edge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#2e7d32;strokeWidth=1.8;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="374" y="260" as="sourcePoint" />
            <mxPoint x="374" y="328" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tel_edge" value="&lt;span style=&quot;font-size:7.5px;color:#1b5e20;font-weight:bold;background:#ffffff;padding:3px 6px;border:1px solid #c8e6c9;border-radius:3px;&quot;&gt;Zero-Lag Telemetry: &amp;lang;&amp;lambda;, p&lt;sub&gt;fast&lt;/sub&gt;, &amp;Delta;p&amp;rang;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="274" y="285" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Telemetry Arrow: Cloud -> CGDA -->
        <mxCell id="arr_tel_cloud" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#e65100;strokeWidth=1.8;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="260" as="sourcePoint" />
            <mxPoint x="750" y="328" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tel_cloud" value="&lt;span style=&quot;font-size:7.5px;color:#bf360c;font-weight:bold;background:#ffffff;padding:3px 6px;border:1px solid #ffe082;border-radius:3px;&quot;&gt;Queue State: &amp;lang;q(t), k(t)&amp;rang;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="685" y="285" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- Scaling Command Arrow: CGDA -> Cloud Workers -->
        <mxCell id="arr_scale_cmd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b71c1c;strokeWidth=2;endArrow=classic;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="856" y="395" as="sourcePoint" />
            <mxPoint x="934" y="175" as="targetPoint" />
            <Array as="points">
              <mxPoint x="948" y="395" />
              <mxPoint x="948" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_scale_cmd" value="&lt;span style=&quot;font-size:7.5px;color:#b71c1c;font-weight:bold;background:#ffffff;padding:3px 5px;border:1px solid #ffcdd2;border-radius:3px;&quot;&gt;Actuation Directive &amp;Delta;k(t)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="844" y="295" width="112" height="22" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

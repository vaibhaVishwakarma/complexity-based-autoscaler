<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Conformal-Triage-Flow">
    <mxGraphModel dx="1000" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="510">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer Frame -->
        <mxCell id="outer_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cfd8dc;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="956" height="486" as="geometry" />
        </mxCell>

        <!-- Diagram Header Title -->
        <mxCell id="title_box" value="&lt;b style=&quot;font-size:13px;color:#1a237e;letter-spacing:0.8px;&quot;&gt;CONFORMAL SPLIT-INFERENCE TRIAGE &amp;amp; FEED-FORWARD TELEMETRY FLOW&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="930" height="26" as="geometry" />
        </mxCell>

        <!-- Step 1: Ingress Client -->
        <mxCell id="node_ingress" value="&lt;b style=&quot;font-size:10px;color:#0d47a1;&quot;&gt;Ingress Stream &amp;lambda;(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#455a64;line-height:1.35;&quot;&gt;Tiny ImageNet-C Payloads&lt;br/&gt;Azure 2019 / Poisson Dynamics&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="26" y="80" width="152" height="66" as="geometry" />
        </mxCell>

        <!-- Arrow: Ingress -> Edge Gateway -->
        <mxCell id="arr_ing_edge" value="" style="endArrow=classic;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="178" y="113" as="sourcePoint" />
            <mxPoint x="238" y="113" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_loc_link" value="&lt;span style=&quot;font-size:7.5px;color:#0288d1;font-weight:bold;&quot;&gt;Local Link&lt;br/&gt;5ms, 1Gbps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=bottom;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="178" y="85" width="60" height="26" as="geometry" />
        </mxCell>

        <!-- Step 2: Edge Gateway Container -->
        <mxCell id="box_edge" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="238" y="60" width="272" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lbl_edge_hdr" value="&lt;b style=&quot;font-size:10px;color:#1b5e20;&quot;&gt;Distributed Edge Gateway (RAPS Triage)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="242" y="64" width="264" height="20" as="geometry" />
        </mxCell>

        <!-- Triage Engine Card -->
        <mxCell id="card_triage" value="&lt;b style=&quot;font-size:8px;color:#1b5e20;&quot;&gt;EfficientNet-B0 ONNX Classifier&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;center&quot; style=&quot;font-size:7px;color:#37474f;line-height:1.35;&quot;&gt;Inference: 10.7ms &amp;bull; Headroom &amp;gt; 300 RPS&lt;br/&gt;Computes Conformal Prediction Set &lt;b&gt;C(x)&lt;/b&gt;&lt;br/&gt;RAPS Calibrated Threshold &lt;b&gt;q&#770; = 0.79914&lt;/b&gt; (&amp;alpha; = 0.10)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#81c784;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="88" width="248" height="50" as="geometry" />
        </mxCell>

        <!-- Conformal Decision Diamond -->
        <mxCell id="node_decision" value="&lt;b style=&quot;font-size:8.5px;color:#e65100;&quot;&gt;Cardinality&lt;br/&gt;|C(x)|&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="329" y="152" width="90" height="46" as="geometry" />
        </mxCell>

        <!-- Arrow: Classifier -> Decision -->
        <mxCell id="arr_card_dec" value="" style="endArrow=classic;html=1;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1">

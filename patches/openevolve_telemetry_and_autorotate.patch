+    def _record_llm_call(self, iteration: int, result: SerializableResult) -> None:
+        """Appends an authoritative record of this LLM call to output_dir/llm_calls.jsonl."""
+        try:
+            import json
+            import time
+            from datetime import datetime, timezone
+            from pathlib import Path
+
+            output_dir = getattr(self.config, "output_dir", None) or "output/evolution_runs"
+            log_file = Path(output_dir) / "llm_calls.jsonl"
+            log_file.parent.mkdir(parents=True, exist_ok=True)
+
+            island_id = result.target_island
+            if island_id is None and result.child_program_dict:
+                island_id = result.child_program_dict.get("metadata", {}).get("island")
+            if island_id is None:
+                island_id = getattr(self.database, "current_island", 0)
+
+            child_id = None
+            changes_summary = None
+            if result.child_program_dict:
+                child_id = result.child_program_dict.get("id")
+                changes_summary = result.child_program_dict.get("metadata", {}).get("changes")
+            elif result.error:
+                changes_summary = f"Error: {result.error}"
+
+            record = {
+                "iteration": iteration,
+                "timestamp": time.time(),
+                "datetime": datetime.now(timezone.utc).isoformat(),
+                "island_id": island_id,
+                "parent_id": result.parent_id,
+                "child_id": child_id,
+                "status": "SUCCESS" if not result.error else "ERROR",
+                "error": result.error,
+                "token_usage": result.token_usage or {},
+                "duration_s": round(result.iteration_time, 2),
+                "changes_summary": changes_summary,
+                "prompt": result.prompt,
+                "llm_response": result.llm_response,
+            }
+            with open(log_file, "a") as f:
+                f.write(json.dumps(record) + "\n")
+        except Exception as e:
+            logger.warning("Failed to record LLM call for iteration %d: %s", iteration, e)
+

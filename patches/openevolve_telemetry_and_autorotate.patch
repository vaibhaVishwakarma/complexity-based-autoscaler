+    def _handle_quota_exhaustion(self) -> Optional[str]:
+        """
+        Attempts to auto-rotate the API key from .env.backup if available.
+        Updates self.api_key, self.client.api_key, and os.environ.
+        """
+        try:
+            from pathlib import Path
+            import sys
+            import os
+            for parent in [Path.cwd(), Path(__file__).resolve().parents[3], Path(__file__).resolve().parents[4]]:
+                if (parent / "scripts" / "rotate_api_key.py").exists():
+                    if str(parent) not in sys.path:
+                        sys.path.insert(0, str(parent))
+                    break
+
+            from scripts.rotate_api_key import (
+                DEFAULT_BACKUP_FILE,
+                DEFAULT_ENV_FILE,
+                rotate_to_next,
+                get_active_key,
+                mask_key,
+            )
+
+            if DEFAULT_BACKUP_FILE.exists():
+                idx, total, masked = rotate_to_next(DEFAULT_BACKUP_FILE, DEFAULT_ENV_FILE)
+                new_key = get_active_key(DEFAULT_ENV_FILE)
+                if new_key and new_key != self.api_key:
+                    self.api_key = new_key
+                    if self.client:
+                        self.client.api_key = new_key
+                    os.environ["GEMINI_API_KEY"] = new_key
+                    logger.info(
+                        f"🔄 [AUTO-KEY-ROTATION] Quota limit encountered. "
+                        f"Automatically rotated to Key #{idx}/{total} [{masked}]."
+                    )
+                    return new_key
+        except Exception as rot_err:
+            logger.warning(f"Auto-key-rotation attempt failed: {rot_err}")
+        return None
+
